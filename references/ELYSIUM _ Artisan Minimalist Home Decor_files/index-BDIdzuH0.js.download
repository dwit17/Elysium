percase text-stone-400 font-mono block",children:"Philosophical Foundation"}),x.jsx("h2",{className:"text-3xl sm:text-4xl lg:text-5xl font-serif font-normal tracking-wide text-[#1A1A1A] leading-[1.25]",children:"Designed for silence. Built for generations."}),x.jsx("div",{className:"w-12 h-[1px] bg-stone-500 my-6"}),x.jsx("p",{className:"text-sm text-stone-500 leading-relaxed font-light font-sans max-w-md",children:"At Elysium, we believe a home is a sanctuary where objects shouldn’t compete for attention. Our pieces are formed slowly with deep respect for raw earth mediums, letting each raw element radiate a quiet, elegant dignity."})]}),x.jsxs("div",{className:"lg:col-span-7 space-y-12",children:[x.jsxs(St.div,{initial:{opacity:0,y:30},whileInView:{opacity:1,y:0},viewport:{once:!0},transition:{duration:1.2},className:"bg-[#EEECE7]/40 p-8 md:p-12 border border-stone-200/30 text-[#1A1A1A] rounded-sm relative",children:[x.jsx("span",{className:"absolute top-2 left-6 text-7xl font-serif text-stone-300 pointer-events-none select-none",children:"“"}),x.jsx("p",{className:"text-lg md:text-xl font-extralight italic text-stone-700 leading-relaxed relative z-10 pl-4",children:"The hand of the artisan creates a conversation with raw geological history. When you hold a vessel or rest on a carved console, you are interacting with limestone that lay quiet for five epochs before it was curated for your home."}),x.jsxs("div",{className:"mt-6 flex items-center justify-end space-x-3",children:[x.jsx("span",{className:"h-[1px] w-8 bg-stone-400"}),x.jsx("span",{className:"text-[10px] tracking-widest uppercase text-stone-400 font-mono",children:"Elysium"})]})]}),x.jsx("div",{className:"grid grid-cols-1 md:grid-cols-3 gap-8 pt-6",children:i.map((l,o)=>x.jsxs(St.div,{initial:{opacity:0,y:25},whileInView:{opacity:1,y:0},viewport:{once:!0},transition:{delay:o*.15,duration:.8},className:"space-y-3",children:[x.jsx("span",{className:"text-xs font-mono text-stone-400 font-bold block",children:l.num}),x.jsx("p",{className:"text-sm font-serif font-medium tracking-wider text-[#1A1A1A] uppercase",children:l.title}),x.jsx("p",{className:"text-xs text-stone-500 leading-relaxed font-light",children:l.desc})]},l.num))})]})]})})]})}const V0=[{id:"caelum-vessel",name:"Caelum Vessel",category:"Vessels",material:"Organic Clay",dimensions:"32cm H × 24cm W",weight:"3.4 kg",origin:"Tuscany, Italy",artisan:"Matteo Ghiberti",description:"A hand-thrown, dual-handled vessel inspired by traditional Roman pottery, featuring an unglazed, textured surface with distinctive iron oxide iron-speckling.",image:"https://images.unsplash.com/photo-1612196808214-b8e1d6145a8c?auto=format&fit=crop&q=80&w=800",price:"€620",details:["Hand-thrown on a manual kickwheel","Fired twice at 1200°C for exceptional strength","Natural specks vary on each piece"]},{id:"solis-table",name:"Solis Travertine Console",category:"Furniture",material:"Travertine Stone",dimensions:"75cm H × 140cm W × 40cm D",weight:"62.0 kg",origin:"Tivoli, Italy",artisan:"Sandro Moretti",description:"A monomaterial console carved from solid Italian travertine. The design highlights clean, absolute geometries and the naturally porous, tactile texture of geological stone.",image:"https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&q=80&w=800",price:"€4,800",details:["Milled from a single raw stone block","Matte honed finish retains natural pore cavities","Hand-finished corners with soft chamfer details"]},{id:"estia-pendant",name:"Estia Pendant Light",category:"Lighting",material:"Plaster Finish",dimensions:"45cm Diameter × 38cm H",weight:"2.8 kg",origin:"Cyclades, Greece",artisan:"Eleni Kora",description:"An organic bowl-shaped hanging light fixture. The exterior lime plaster shell diffuses downlight warmly, reflecting the pure simplicity of traditional Cycladic architecture.",image:"https://images.unsplash.com/photo-1507473885765-e6ed057f782c?auto=format&fit=crop&q=80&w=800",price:"€1,150",details:["Crafted with limestone-based mineral plaster","Textured exterior paired with a smooth, warm-colored interior reflector","Solid brass canopy and raw natural linen cord"]},{id:"monolith-chair",name:"Monolith Lounge Chair",category:"Furniture",material:"Sculptural Oak",dimensions:"68cm H × 78cm W × 72cm D",weight:"28.0 kg",origin:"Kyoto, Japan",artisan:"Kenji Yoshino",description:"A sweeping, sculptural seat carved from air-dried Japanese white oak. This monolithic design emphasizes low proportions and raw, continuous grain flow across the curved timber joint.",image:"https://images.unsplash.com/photo-1592078615290-033ee584e267?auto=format&fit=crop&q=80&w=800",price:"€3,200",details:["Joined with traditional glueless mortise-and-tenon joints","Charred Shou Sugi Ban accents protect and enrich the grain","Coated solely with mountain beeswax and organic flaxseed oil"]},{id:"terra-relief",name:"Terra Plaster Relief",category:"Sculpture",material:"Plaster Finish",dimensions:"110cm H × 85cm W",weight:"9.5 kg",origin:"Marseille, France",artisan:"Elysium",description:"An abstract wall sculpture displaying clean directional curves. Plaster mixed with pure sea sand catches ambient light throughout the day, altering its shadows step by step.",image:"https://images.unsplash.com/photo-1615529182904-14819c35db37?auto=format&fit=crop&q=80&w=800",price:"€1,950",details:["Structured on a double-layer marine plywood backing","Sealed with archival museum-grade UV-protective matte lacquer","Ready to mount with recessed heavy-duty aluminum cleats"]},{id:"aura-bowl",name:"Aura Alabaster Bowl",category:"Vessels",material:"Travertine Stone",dimensions:"12cm H × 30cm Diameter",weight:"4.8 kg",origin:"Volterra, Italy",artisan:"Lorenzo Nardi",description:"A shallow stone bowl carved with precision from premium translucent alabaster stone, exhibiting beautiful warm amber veins that illuminate beautifully when kissed by ambient light.",image:"https://images.unsplash.com/photo-1578749556568-bc2c40e68b61?auto=format&fit=crop&q=80&w=800",price:"€490",details:["Lathe-turned and hand-scraped to paper-thin segments","Translucent properties illuminate under candle or sunlight","Not suitable for standing water; ideal for dried arrangements"]},{id:"chronos-jar",name:"Chronos Storage Jar",category:"Vessels",material:"Organic Clay",dimensions:"52cm H × 35cm W",weight:"11.2 kg",origin:"Crete, Greece",artisan:"Dimitris Patrikas",description:"An oversized storage vessel with rough, crater-like textures reminiscent of maritime relics retrieved from the Mediterranean sea floor.",image:"https://images.unsplash.com/photo-1600121848594-d8644e57abab?auto=format&fit=crop&q=80&w=800",price:"€1,850",details:["Coarse stoneware clay mixed with pulverized terracotta shards (grog)","Aged outdoors for six months to attract beautiful local mineral oxidation","Stamped with the mark of the hereditary Cretan workshop"]},{id:"nidus-stool",name:"Nidus block Stool",category:"Furniture",material:"Sculptural Oak",dimensions:"42cm H × 35cm W × 35cm D",weight:"14.5 kg",origin:"Black Forest, Germany",artisan:"Stefan Brandt",description:"A solid hexagonal timber column. Cracked intentionally during drying to embrace wabi-sabi philosophy, then securely keyed with beautiful butterfly keys.",image:"https://images.unsplash.com/photo-1567538096630-e0c55bd6374c?auto=format&fit=crop&q=80&w=800",price:"€890",details:["Sourced from certified 120-year-old eco-managed oak woods","Naturally oil-cured to lock deep chestnut and walnut undertones","Functional as an accent table, pedestal, or seating"]}],_0=[{id:"travertine",name:"Travertine Stone",description:"A mineral-rich sedimentary stone deposited by geothermal mineral springs. Noted for its signature cellular voids, cream-beige hues, and ancient structural durability.",characteristics:["Porous geomorphic cavities","Warm earth-bound light absorption","Heirloom density & geological strength"],tactility:"Rough-hewed matte raw stone, lightly polished and cooling to the touch.",color:"#D8CEBE",bgTexture:"bg-[#D2C8B8]",image:"https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&q=80&w=400"},{id:"clay",name:"Organic Stoeware Clay",description:"Fine-grained sediment containing natural iron, quartz sand, and organic decomposed granite particles sourced from fluvial stream beds.",characteristics:["Warm, mineral iron speckling","High thermal Vitrification","Highly tactile fingerprint ridges"],tactility:"Grainy, mineral warmth with a matte grip in unglazed areas.",color:"#C3B091",bgTexture:"bg-[#C8B8A2]",image:"https://images.unsplash.com/photo-1612196808214-b8e1d6145a8c?auto=format&fit=crop&q=80&w=400"},{id:"oak",name:"Crafted Oak Timber",description:"Heirloom forest white oak, grown slowly in northern cooler climates to foster tight annual ring patterns and dense fibrous structure.",characteristics:["Dense, strong annual grain configurations","High tannins that naturally darken with Shou Sugi treatment","Responsive breathing grain wood"],tactility:"Warm, fibrous satin texture with organic contours carved by hand.",color:"#A89276",bgTexture:"bg-[#AF9A7F]",image:"https://images.unsplash.com/photo-1592078615290-033ee584e267?auto=format&fit=crop&q=80&w=400"},{id:"plaster",name:"Textured Lime Plaster",description:"Traditional stucco composed of hydrated calcium hydroxide from cooked limestone, ground marble river aggregate, and natural organic pigments.",characteristics:["Direct structural reflection","Chalky daylight diffusion","Multi-layered relief depth"],tactility:"Ultra-dry, velvety chalkiness with fine sandy ridges.",color:"#E6DFD5",bgTexture:"bg-[#ECE5DC]",image:"https://images.unsplash.com/photo-1615529182904-14819c35db37?auto=format&fit=crop&q=80&w=400"}],VA=[{id:"extraction",title:"Extraction & Selection",artisan:"Sandro Moretti",description:"Our raw blocks are sourced directly from independent historical quarries in Tuscany and the Peloponnese, picking only blocks showing robust natural fault lines.",duration:"2 to 3 days per block",tools:["Pneumatic splitting wedges","Diamond-tipped hand saws","Traditional iron picks"],image:"https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&q=80&w=600"},{id:"forming",title:"Precision Sculpting",artisan:"Kenji Yoshino & Matteo Ghiberti",description:"Artisans execute shaping using traditional manual processes—chisels for stone, kickwheels for clay, and ancient copper saws for wood joints, keeping wood-glues and chemical compounds out of our processes.",duration:"15 to 30 hours per piece",tools:["Manual kickwheels","Tempered iron flat chisels","Traditional copper joints"],image:"https://images.unsplash.com/photo-1612196808214-b8e1d6145a8c?auto=format&fit=crop&q=80&w=600"},{id:"finishing",title:"Tactile Hand Buffing",artisan:"Eleni Kora",description:"Instead of synthetic coatings, we hand-rub surfaces with pulverized pumice stone, linseed oil, and organic desert wax. This preserves natural wood breathing and the limestone aroma.",duration:"5 to 8 days of drying & curing",tools:["Pulverized pumice stones","Purified natural mountain beeswax","Broad brush fiber rags"],image:"https://images.unsplash.com/photo-1507473885765-e6ed057f782c?auto=format&fit=crop&q=80&w=600"}];function _A(){const[i,l]=G.useState("All"),[o,u]=G.useState(null),c=["All","Furniture","Sculpture","Lighting","Vessels"],h=i==="All"?V0:V0.filter(f=>f.category===i);return x.jsx("section",{id:"gallery",className:"py-24 bg-[#F9F8F6] px-6 md:px-12 lg:px-24",children:x.jsxs("div",{className:"max-w-7xl mx-auto",children:[x.jsxs("div",{className:"flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16 border-b border-stone-200 pb-8",children:[x.jsxs("div",{className:"space-y-3",children:[x.jsx("span",{className:"text-[10px] tracking-[0.45em] uppercase text-stone-400 font-mono block",children:"Artisan Collection"}),x.jsx("h2",{className:"text-4xl lg:text-5xl font-serif font-normal tracking-wide text-[#1A1A1A] mb-2",ch